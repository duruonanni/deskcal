{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌历",
  "version": "0.1.1",
  "identifier": "dev.deskcal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "widget",
        "title": "桌历",
        "width": 960,
        "height": 1040,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true,
        "url": "/index.html?window=widget"
      },
      {
        "label": "settings",
        "title": "设置",
        "width": 520,
        "height": 640,
        "decorations": true,
        "skipTaskbar": false,
        "visible": false,
        "url": "/index.html?window=settings"
      },
      {
        "label": "list",
        "title": "未完成",
        "width": 420,
        "height": 560,
        "decorations": true,
        "skipTaskbar": false,
        "visible": false,
        "url": "/index.html?window=list"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
